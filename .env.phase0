# ============================================
# Phase 0: Environment Variables
# Copy to .env and fill with your secrets
# NEVER commit this file!
# ============================================

# ---- JWT Secret (CRITICAL FIX #1) ----
# Generate: openssl rand -base64 32
CYBERAS_JWT_SECRET=your-secret-key-minimum-32-chars-long-must-be-random

# ---- PostgreSQL ----
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_USER=cyberas
POSTGRES_DB=cyberas

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=optional-redis-password

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Email Configuration (for verification codes) ----
QUARKUS_MAILER_HOST=smtp.gmail.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_USERNAME=your-email@gmail.com
QUARKUS_MAILER_PASSWORD=your-app-specific-password
QUARKUS_MAILER_FROM=noreply@cyberas.local

# ---- Application ----
QUARKUS_HTTP_PORT=8080
QUARKUS_APPLICATION_VERSION=1.0.0-SNAPSHOT

# ---- Logging ----
QUARKUS_LOG_LEVEL=INFO
QUARKUS_LOG_CATEGORY__COM_CYBERAS__LEVEL=DEBUG

# ---- CORS Configuration ----
QUARKUS_HTTP_CORS_ORIGINS=https://cyberas.local,http://localhost:3000

# ---- Environment ----
QUARKUS_PROFILE=dev
# For production, set to: prod
