# Configuration CYBERAS Intelligence
#
# Copier en .env et renseigner les valeurs. Le fichier .env ne doit jamais être
# commité : il est ignoré par .gitignore.

# --- Base de données ---
DB_URL=jdbc:postgresql://localhost:5432/cyberas
DB_USERNAME=cyberas
DB_PASSWORD=

# --- Sécurité ---
# Obligatoire en production. Minimum 256 bits pour HS256.
# Génération : openssl rand -base64 48
JWT_SECRET=

# --- Messagerie ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Cache ---
REDIS_HOSTS=redis://localhost:6379

# --- Fournisseur d'analyse IA ---
# Sans clé, l'application démarre normalement et signale AI_PROVIDER_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
